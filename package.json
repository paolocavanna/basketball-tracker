{
  "name": "basketball-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm ci --prefix frontend && npm run typecheck && npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "db:setup": "tsx scripts/apply-schema.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"frontend/src/**/*.css\"",
    "lint:css:fix": "stylelint \"frontend/src/**/*.css\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vue-tsc": "^3.3.11"
  }
}
